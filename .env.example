# CloudPBX Admin Dashboard - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it is gitignored by default

# =============================================================================
# DATABASE (Required)
# =============================================================================
DATABASE_URL="postgresql://username:password@localhost:5432/cloudpbx"

# =============================================================================
# SERVER CONFIGURATION (Optional)
# =============================================================================
PORT=5000                    # HTTP server port (default: 5000)
NODE_ENV=development         # Environment: development | production

# =============================================================================
# SECURITY (Required in production)
# =============================================================================
# Admin authentication token - REQUIRED for API access
# Must be at least 32 characters, cannot contain placeholder words
# Generate with: openssl rand -base64 48
ADMIN_TOKEN=

# CORS allowed origins (comma-separated)
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Do NOT use wildcard (*) with credentials
ALLOWED_ORIGINS=

# Webhook signature verification (if using webhooks)
TWILIO_AUTH_TOKEN=           # Twilio auth token for webhook signature verification
GITHUB_WEBHOOK_SECRET=       # GitHub webhook secret
STRIPE_WEBHOOK_SECRET=       # Stripe webhook secret

# =============================================================================
# AI FEATURES (Optional - for AI assistant functionality)
# =============================================================================
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...        # OpenAI API key
AI_INTEGRATIONS_OPENAI_BASE_URL=             # Optional: custom OpenAI endpoint

# =============================================================================
# TRADING SYSTEM (Optional - for Polymarket integration)
# =============================================================================
TRADING_MODEL_WORKER_URL=http://127.0.0.1:8001     # Trading model service
TRADING_CYCLE_MS=300000                             # Cycle interval (ms, default: 5min)
TRADING_MARKET_LIMIT=40                             # Max markets to monitor
TRADING_DEFAULT_BANKROLL_USD=100000                 # Starting capital (USD)
TRADING_TOP_CATEGORIES=Politics,Macro,Crypto       # Categories to trade

POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_EXECUTION_BASE_URL=                      # Polymarket execution proxy URL
POLYMARKET_EXECUTION_API_KEY=                       # Polymarket API key

# =============================================================================
# REPLIT-SPECIFIC (Optional - ignore if not using Replit)
# =============================================================================
REPLIT_CONNECTORS_HOSTNAME=
REPL_IDENTITY=
WEB_REPL_RENEWAL=

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never share .env files or commit them to version control
# - Rotate credentials immediately if accidentally exposed
# - Use strong, randomly generated passwords
# - For production, use a secrets management service (AWS Secrets Manager,
#   HashiCorp Vault, etc.) rather than .env files
