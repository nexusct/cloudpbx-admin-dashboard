# Database Configuration
# PostgreSQL connection string for the CloudPBX database
DATABASE_URL=postgresql://user:password@localhost:5432/cloudpbx

# Server Configuration
# Port for the Express server (default: 5000)
PORT=5000

# Node Environment (development, production, test)
NODE_ENV=development

# AI Integration Settings
# OpenAI API key for AI assistant functionality
# SECURITY: Never commit actual API keys. Obtain from OpenAI dashboard.
AI_INTEGRATIONS_OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI base URL for proxy or alternative endpoint
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Replit Integration (if using Replit deployment)
# Replit identity token for connector authentication
REPL_IDENTITY=

# Web deployment renewal token
WEB_REPL_RENEWAL=

# Replit connectors hostname
REPLIT_CONNECTORS_HOSTNAME=connectors.replit.com

# Trading System Configuration (if using trading features)
# Polymarket API key for execution
# SECURITY: Never commit actual API keys
POLYMARKET_EXECUTION_API_KEY=your_polymarket_api_key_here

# Polymarket API endpoints
POLYMARKET_EXECUTION_BASE_URL=https://api.polymarket.com
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com

# Trading system parameters
TRADING_CYCLE_MS=300000
TRADING_DEFAULT_BANKROLL_USD=100
TRADING_MARKET_LIMIT=10
TRADING_TOP_CATEGORIES=crypto,politics,sports
TRADING_MODEL_WORKER_URL=

# PostgreSQL Connection Settings (optional overrides)
# Connection timeout in seconds
PGCONNECT_TIMEOUT=10

# SSL mode for PostgreSQL connection (disable, allow, prefer, require, verify-ca, verify-full)
PGSSLMODE=prefer

# Google API Configuration (if needed)
# SECURITY WARNING: A google_api_key was previously leaked in this repository.
# If you are Jim Mazza (repo owner): You MUST rotate any Google API keys that were
# committed to this repository by going to Google Cloud Console and creating new keys.
# The same leaked key may appear in multiple nexusct repositories.
# 
# After rotation, update this value with the new key and NEVER commit the actual key.
GOOGLE_API_KEY=your_google_api_key_here

# Security Notes:
# 1. NEVER commit this file with actual credentials
# 2. Add .env to .gitignore to prevent accidental commits
# 3. Use environment-specific .env files (.env.local, .env.production)
# 4. Rotate all API keys if accidentally committed to version control
# 5. Use secret management services for production deployments
